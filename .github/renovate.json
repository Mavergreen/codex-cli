{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>Mavergreen/shipyard"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Codex, pinned as the family pins a tag with its commit: REF is the release tag rust-v<x.y.z> and DIGEST its commit, which Renovate moves together. The versioning admits only stable rust-v<x.y.z> tags, so prereleases (rust-v0.162.0-alpha.1) are never proposed.",
      "managerFilePatterns": ["/^components/codex/version$/"],
      "matchStrings": ["REPO=(?<packageName>\\S+?)\\.git\\s+REF=(?<currentValue>\\S+)\\s+DIGEST=(?<currentDigest>[0-9a-f]{40})"],
      "depNameTemplate": "openai/codex",
      "datasourceTemplate": "git-refs",
      "versioningTemplate": "regex:^rust-v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    {
      "customType": "regex",
      "description": "The Rust toolchain pin: a Mavergreen/rust release tag, bare.",
      "managerFilePatterns": ["/^components/rust/version$/"],
      "matchStrings": ["^(?<currentValue>\\S+)\\s*$"],
      "depNameTemplate": "Mavergreen/rust",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-mavericks\\.(?<build>\\d+)$"
    },
    {
      "customType": "regex",
      "description": "The clang-22 pin: a Mavergreen/clang-22 release tag, bare.",
      "managerFilePatterns": ["/^components/clang-22/version$/"],
      "matchStrings": ["^(?<currentValue>\\S+)\\s*$"],
      "depNameTemplate": "Mavergreen/clang-22",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-mavericks\\.(?<build>\\d+)$"
    }
  ]
}
