+/// Returns the platform native roots, loaded once per process.
+///
+/// macOS 10.9: loading them takes about half a second there, and Codex builds many clients.
+fn native_root_certificates() -> &'static [CertificateDer<'static>] {
+    static ROOTS: OnceLock<Vec<CertificateDer<'static>>> = OnceLock::new();
+    ROOTS.get_or_init(|| {
+        let rustls_native_certs::CertificateResult { certs, errors, .. } =
+            rustls_native_certs::load_native_certs();
+        if !errors.is_empty() {
+            warn!(
+                native_root_error_count = errors.len(),
+                "encountered errors while loading native root certificates"
+            );
+        }
+        certs
+    })
+}
+
+/// Returns the rustls config that reqwest clients without their own roots or identity share.
+///
+/// macOS 10.9: it trusts the platform native roots, as reqwest's own rustls config would, and
+/// offers the ALPN protocols reqwest would offer, since reqwest sets neither on a preconfigured
+/// config. It is built once per process; each caller gets a cheap clone. The roots load on the
+/// first certificate check, not here, so a client that never makes a TLS connection never pays.
+pub fn shared_system_roots_rustls_config() -> ClientConfig {
+    static CONFIG: OnceLock<ClientConfig> = OnceLock::new();
+    CONFIG
+        .get_or_init(|| {
+            ensure_rustls_crypto_provider();
+            let builder = ClientConfig::builder();
+            let verifier = NativeRootsVerifier {
+                provider: Arc::clone(builder.crypto_provider()),
+                inner: OnceLock::new(),
+            };
+            let mut config = builder
+                .dangerous()
+                .with_custom_certificate_verifier(Arc::new(verifier))
+                .with_no_client_auth();
+            config.alpn_protocols = vec![b"h2".to_vec(), b"http/1.1".to_vec()];
+            config
+        })
+        .clone()
+}
+
+/// Verifies server certificates with rustls's own WebPKI verifier over the platform native roots,
+/// building it on the first check.
+///
+/// macOS 10.9: loading the roots takes about half a second there. Every check is delegated
+/// unchanged; only the moment the roots load moves.
+#[derive(Debug)]
+struct NativeRootsVerifier {
+    provider: Arc<rustls::crypto::CryptoProvider>,
+    inner: OnceLock<Result<Arc<rustls::client::WebPkiServerVerifier>, rustls::Error>>,
+}
+
+impl NativeRootsVerifier {
+    fn verifier(&self) -> Result<&Arc<rustls::client::WebPkiServerVerifier>, rustls::Error> {
+        self.inner
+            .get_or_init(|| {
+                let mut root_store = RootCertStore::empty();
+                let _ = root_store
+                    .add_parsable_certificates(native_root_certificates().iter().cloned());
+                rustls::client::WebPkiServerVerifier::builder_with_provider(
+                    Arc::new(root_store),
+                    Arc::clone(&self.provider),
+                )
+                .build()
+                .map_err(|error| {
+                    rustls::Error::General(format!(
+                        "cannot verify server certificates with the platform roots: {error}"
+                    ))
+                })
+            })
+            .as_ref()
+            .map_err(Clone::clone)
+    }
+}
+
+impl ServerCertVerifier for NativeRootsVerifier {
+    fn verify_server_cert(
+        &self,
+        end_entity: &CertificateDer<'_>,
+        intermediates: &[CertificateDer<'_>],
+        server_name: &rustls_pki_types::ServerName<'_>,
+        ocsp_response: &[u8],
+        now: rustls_pki_types::UnixTime,
+    ) -> Result<rustls::client::danger::ServerCertVerified, rustls::Error> {
+        self.verifier()?.verify_server_cert(
+            end_entity,
+            intermediates,
+            server_name,
+            ocsp_response,
+            now,
+        )
+    }
+
+    fn verify_tls12_signature(
+        &self,
+        message: &[u8],
+        cert: &CertificateDer<'_>,
+        dss: &rustls::DigitallySignedStruct,
+    ) -> Result<rustls::client::danger::HandshakeSignatureValid, rustls::Error> {
+        self.verifier()?.verify_tls12_signature(message, cert, dss)
+    }
+
+    fn verify_tls13_signature(
+        &self,
+        message: &[u8],
+        cert: &CertificateDer<'_>,
+        dss: &rustls::DigitallySignedStruct,
+    ) -> Result<rustls::client::danger::HandshakeSignatureValid, rustls::Error> {
+        self.verifier()?.verify_tls13_signature(message, cert, dss)
+    }
+
+    fn supported_verify_schemes(&self) -> Vec<rustls::SignatureScheme> {
+        self.provider
+            .signature_verification_algorithms
+            .supported_schemes()
+    }
+}
