+use codex_install_context::mavergreen::BuildId;
+
+// Mavergreen: versions are Mavergreen build ids (`x.y.z-mavericks.N`), which order a rebuild of a
+// Codex version after the version itself; anything that is not a build id never counts as newer.
+#[cfg(any(not(debug_assertions), test))]
+pub(crate) fn mavergreen_upgrade_available(latest: &str, current: &str) -> bool {
+    match (BuildId::parse(latest), BuildId::parse(current)) {
+        (Some(latest), Some(current)) => latest > current,
+        _ => false,
     }
 }
 
+// Mavergreen: the running build is its package manifest's build id, or, without one, the plain Codex
+// version, which any rebuild of it follows.
+pub(crate) fn running_build() -> String {
+    codex_install_context::mavergreen::current_build_id(
+        codex_install_context::InstallContext::current(),
+    )
+    .unwrap_or_else(|| crate::version::CODEX_CLI_VERSION.to_string())
+}
+
+// Mavergreen: the "from" and "to" of an update notice. A rebuild of the running Codex version shows
+// both build ids, since only the build number tells them apart; a new Codex version shows both
+// plain versions, as upstream's notice does. Anything that is not a build id is shown as it is.
+pub(crate) fn update_notice_versions(current: &str, latest: &str) -> (String, String) {
+    use codex_install_context::mavergreen::BuildId;
+    match (BuildId::parse(current), BuildId::parse(latest)) {
+        (Some(from), Some(to))
+            if (from.major, from.minor, from.patch) != (to.major, to.minor, to.patch) =>
+        {
+            (
+                BuildId { build: 0, ..from }.to_string(),
+                BuildId { build: 0, ..to }.to_string(),
+            )
+        }
+        _ => (current.to_string(), latest.to_string()),
+    }
+}
+
