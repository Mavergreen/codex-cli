+// Mavergreen: the package's installer exits 3 when the newest build needs a newer codex-cli package.
+// It installs nothing, says so, and opens the package's updater only when somebody is watching, so
+// the message does not assume the updater opened.
+const MAVERGREEN_NEEDS_NEWER_PACKAGE_EXIT: i32 = 3;
+
+fn mavergreen_update_failure(action: UpdateAction, exit_code: Option<i32>) -> Option<&'static str> {
+    (action == UpdateAction::StandaloneUnix
+        && exit_code == Some(MAVERGREEN_NEEDS_NEWER_PACKAGE_EXIT))
+    .then_some(
+        "Codex was not updated: the newest build needs a newer codex-cli package. Get it with the package's updater or from https://github.com/Mavergreen/codex-cli/releases/latest, then run `codex update` again.",
+    )
+}
