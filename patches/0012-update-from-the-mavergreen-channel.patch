+pub(crate) fn mavergreen_build_from_latest_json(body: &str) -> anyhow::Result<String> {
+    #[derive(serde::Deserialize)]
+    struct LatestJson {
+        mavergreen_build: Option<String>,
+    }
+
+    let LatestJson { mavergreen_build } = serde_json::from_str(body)
+        .map_err(|err| anyhow::anyhow!("Failed to parse latest.json: {err}"))?;
+    let build = mavergreen_build
+        .ok_or_else(|| anyhow::anyhow!("latest.json does not name a mavergreen_build"))?;
+    match BuildId::parse(&build) {
+        Some(id) if id.build >= 1 => Ok(build),
+        _ => Err(anyhow::anyhow!(
+            "latest.json names an invalid mavergreen_build '{build}'"
+        )),
+    }
 }
 
