+#[test]
+fn code_mode_host_program_follows_a_symlinked_codex_to_its_directory() -> std::io::Result<()> {
+    let root = tempfile::tempdir()?;
+    let install_dir = root.path().join("install");
+    let link_dir = root.path().join("link");
+    fs::create_dir_all(&install_dir)?;
+    fs::create_dir_all(&link_dir)?;
+    let exe_path = install_dir.join("codex");
+    fs::write(&exe_path, "")?;
+    fs::write(install_dir.join(CODE_MODE_HOST_EXECUTABLE_NAME), "")?;
+    let link_path = link_dir.join("codex");
+    std::os::unix::fs::symlink(&exe_path, &link_path)?;
+    let canonical_install_dir = AbsolutePathBuf::from_absolute_path(install_dir.canonicalize()?)?;
+
+    let context = InstallContext::from_exe(
+        /*is_macos*/ true,
+        /*current_exe*/ Some(&link_path),
+        /*method_override*/ None,
+    );
+
+    assert_eq!(
+        context.code_mode_host_program_from_exe(Some(&link_path)),
+        canonical_install_dir
+            .join(CODE_MODE_HOST_EXECUTABLE_NAME)
+            .into_path_buf()
+    );
+    Ok(())
+}
