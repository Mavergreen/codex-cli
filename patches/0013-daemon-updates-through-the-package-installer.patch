+// Mavergreen: the daemon's first release is named for the package's build, as the package's installer
+// names the releases it installs, so the daemon's updater keeps running after its first update.
+#[tokio::test]
+async fn a_mavergreen_package_seeds_a_release_named_for_its_build() {
+    let temp = tempfile::TempDir::new().expect("temp");
+    let home = temp.path().join("home");
+    let source = temp
+        .path()
+        .join("standalone/releases/0.152.0-mavericks.3-target");
+    let bin = package(&source, "0.152.0");
+    let mut manifest: serde_json::Value =
+        serde_json::from_slice(&std::fs::read(source.join("codex-package.json")).unwrap()).unwrap();
+    manifest["mavergreenBuild"] = "0.152.0-mavericks.3".into();
+    std::fs::write(source.join("codex-package.json"), manifest.to_string()).unwrap();
+    prepare_from_package(
+        &daemon(&home),
+        &DaemonSettings::default(),
+        InstallMode::Missing,
+        Some(&source),
+        &bin,
+        |_| Ok(true),
+    )
+    .await
+    .expect("seed");
+
+    let root = home.join("packages/app-server-daemon");
+    let name = format!("0.152.0-mavericks.3-{}", super::platform_target().unwrap());
+    assert_eq!(
+        root.join("current").canonicalize().unwrap(),
+        root.join("releases").join(&name).canonicalize().unwrap()
+    );
+    assert_eq!(
+        std::fs::read_to_string(root.join("auto-update-version")).unwrap(),
+        name
+    );
+    assert!(crate::managed_install::is_stable_standalone_release(
+        &home,
+        &crate::managed_install::managed_codex_bin(&home)
+    ));
+}
