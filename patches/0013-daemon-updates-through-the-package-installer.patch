+// Mavergreen: the package's installer names a release for its build, `<x.y.z>-mavericks.<N>`.
+#[cfg(unix)]
+#[test]
+fn mavergreen_build_releases_are_stable() {
+    let home = tempfile::TempDir::new().expect("home");
+    let root = home.path().join("packages/app-server-daemon");
+    let current = root.join("current");
+    let marker = root.join("auto-update-version");
+    for (name, stable) in [
+        ("0.161.0-mavericks.2-x86_64-apple-darwin", true),
+        ("0.161.0-x86_64-apple-darwin", true),
+        ("0.161.0-mavericks.0-x86_64-apple-darwin", false),
+        ("0.161.0-mavericks.x-x86_64-apple-darwin", false),
+        ("0.161.0-mavericks-x86_64-apple-darwin", false),
+    ] {
+        let release = root.join("releases").join(name);
+        let managed = release.join("bin/codex");
+        std::fs::create_dir_all(managed.parent().expect("bin parent")).expect("release");
+        std::fs::write(&managed, b"build").expect("managed bin");
+        let _ = std::fs::remove_file(&current);
+        std::os::unix::fs::symlink(&release, &current).expect("current release");
+        std::fs::write(&marker, name).expect("latest selection");
+        assert_eq!(
+            super::is_stable_standalone_release(home.path(), &managed),
+            stable,
+            "{name}"
+        );
+    }
+}
