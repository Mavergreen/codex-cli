+/// Reads the installer script the package put on disk, instead of downloading one.
+///
+/// The packaged installer updates from the Mavergreen channel and refuses anything unsigned, so
+/// the daemon never fetches or runs a script from the network. The URL the loop passes is the
+/// script's path and is not interpreted.
+struct LocalInstaller {
+    path: PathBuf,
+}
+
+fn local_installer() -> LocalInstaller {
+    LocalInstaller {
+        path: PathBuf::from(INSTALLER_PATH),
+    }
+}
+
+impl InstallerHttp for LocalInstaller {
+    async fn get(&self, _url: &str) -> Result<InstallerResponse> {
+        let body = std::fs::read(&self.path).with_context(|| {
+            format!(
+                "failed to read the package installer at {}",
+                self.path.display()
+            )
+        })?;
         Ok(InstallerResponse::Success(body))
     }
 }
