+/// Mavergreen: a debug build finds a resource beside the calling crate's sources, as upstream does.
+/// A release build compiles in no source-tree path, so two builds of one source in different
+/// directories are the same bytes; it reports the resource as unavailable instead.
+#[cfg(not(codex_bazel))]
+#[cfg(debug_assertions)]
+#[doc(hidden)]
+#[macro_export]
+macro_rules! __cargo_source_dir {
+    ($resource:expr) => {{
+        let manifest_dir = std::path::Path::new(env!("CARGO_MANIFEST_DIR"));
+        std::io::Result::Ok(manifest_dir.join($resource))
+    }};
+}
+
+#[cfg(not(codex_bazel))]
+#[cfg(not(debug_assertions))]
+#[doc(hidden)]
+#[macro_export]
+macro_rules! __cargo_source_dir {
+    ($resource:expr) => {{
+        $crate::source_dir_unavailable($resource)
+    }};
+}
+
+#[cfg(not(codex_bazel))]
+#[doc(hidden)]
+pub fn source_dir_unavailable(resource: &Path) -> std::io::Result<PathBuf> {
+    let resource = resource.display();
+    Err(std::io::Error::new(
+        std::io::ErrorKind::NotFound,
+        format!("{resource} is found beside Codex's sources, which a release build does not record"),
+    ))
+}
